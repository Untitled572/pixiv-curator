# Example only: the application reads environment variables, not .env files.
# Local development:
PIXIV_CURATOR_ADDR=127.0.0.1:5722
PIXIV_CURATOR_LOG_LEVEL=info
PIXIV_CURATOR_DATABASE_PATH=data/curator.db
# Used for JSON image URLs and admin Origin checks; set a client-reachable origin.
PIXIV_CURATOR_PUBLIC_BASE_URL=http://127.0.0.1:5722
# Optional; without this file all management routes reject requests.
# Store under a private directory (0700), file permissions 0600.
# PIXIV_CURATOR_ADMIN_TOKEN_FILE=/absolute/private/admin-token
# Optional Pixiv account; both files stay outside Git.
# Refresh token file is writable for token rotation, not read-only mounted.
# PIXIV_CURATOR_PIXIV_TOKEN_FILE=/absolute/private/pixiv-refresh-token
# PIXIV_CURATOR_OAUTH_CONFIG_FILE=/absolute/private/oauth.json
# Optional local desktop login; scripts/dev.sh configures both automatically.
# PIXIV_CURATOR_LOGIN_PYTHON=/absolute/private/venv/bin/python
# PIXIV_CURATOR_LOGIN_HELPER=/absolute/repo/scripts/pixiv-login.py

# Outbound requests inherit standard proxy environment variables.
# Export explicitly; this application does not load .env automatically.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
# In Docker, use a reachable proxy host instead of container loopback.

# Optional private network settings file, editable via management UI.
# Default: <database directory>/private/network.json
# PIXIV_CURATOR_NETWORK_CONFIG_FILE=/absolute/private/network.json
